parameters:
    level: 8
    paths:
        - src
        - tests
        - phpstan
    # Rule-test fixtures contain deliberately invalid call sites — the
    # RuleTestCase asserts the errors they produce, so the main run must
    # not scan them.
    excludePaths:
        analyseAndScan:
            - tests/Unit/PHPStan/Fixtures/NarrowUnionFixture.php
            - tests/Unit/PHPStan/Fixtures/NarrowUnionCallSite.php
            # A metadata-error fixture feeding a deliberately NON-model
            # class-string to #[MorphDelete] — the runtime is_a gate in
            # MetadataFactory::collectMorphDeletes() is the real check.
            - tests/Unit/Metadata/Fixtures/MdNonModelParent.php
services:
    -
        class: BlueprintAU\Radiant\PHPStan\Rules\RequireStrictTypesRule
        tags:
            - phpstan.rules.rule
    -
        class: BlueprintAU\Radiant\PHPStan\Rules\DisallowUnusedImportsRule
        tags:
            - phpstan.rules.rule
    -
        class: BlueprintAU\Radiant\PHPStan\Rules\DisallowNarrowUnionArgumentsRule
        tags:
            - phpstan.rules.rule
    -
        class: BlueprintAU\Radiant\PHPStan\Rules\RequireDocCommentRule
        tags:
            - phpstan.rules.rule
    -
        class: BlueprintAU\Radiant\PHPStan\Rules\RequireNamespaceRule
        arguments:
            psr4Map:
                'BlueprintAU\Radiant\': 'src/'
                'BlueprintAU\Radiant\Tests\': 'tests/'
                'BlueprintAU\Radiant\PHPStan\': 'phpstan/'
        tags:
            - phpstan.rules.rule
