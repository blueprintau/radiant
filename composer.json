{
    "name": "blueprintau/radiant",
    "description": "A database and ORM package for BlueprintAU — a fail-fast, explicit query builder, SQL connection layer, and attribute-driven ORM.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "database",
        "orm",
        "query-builder",
        "sql",
        "mysql",
        "sqlite",
        "postgres",
        "blueprintau"
    ],
    "support": {
        "issues": "https://github.com/blueprintau/radiant/issues",
        "source": "https://github.com/blueprintau/radiant"
    },
    "authors": [
        {
            "name": "Mineubob"
        }
    ],
    "require": {
        "php": "^8.4",
        "blueprintau/collections": "^1.0@dev",
        "nesbot/carbon": "^3.13"
    },
    "require-dev": {
        "nikic/php-parser": "^5.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "BlueprintAU\\Radiant\\": "src/"
        },
        "exclude-from-classmap": [
            "tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BlueprintAU\\Radiant\\Tests\\": "tests/",
            "BlueprintAU\\Radiant\\PHPStan\\": "phpstan/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "phpunit --group integration-remote-sql",
        "test:all": "phpunit --group default,integration-remote-sql",
        "analyse": "phpstan analyse --memory-limit=512M",
        "security:audit": "composer audit --locked"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "prefer-stable": true
    },
    "minimum-stability": "stable"
}
