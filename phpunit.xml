<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="BlueprintAU Radiant">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <!-- Live-server tests (group "integration-remote-sql": real MySQL and
         Postgres connections) are excluded from the default local run.
         They fail (never skip) when no server is reachable, so the caller
         must opt in explicitly (or drop this exclusion in CI, where the
         servers exist and a failure is a real signal). -->
    <groups>
        <exclude>
            <group>integration-remote-sql</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>